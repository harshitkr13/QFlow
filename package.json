{
  "name": "qflow",
  "version": "1.0.0",
  "description": "QFlow — Virtual Queue & Appointment Management Platform",
  "main": "src/server/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/server.js",
    "build": "npm run build:client",
    "dev:server": "nodemon src/server/server.js",
    "dev:client": "vite --config src/client/vite.config.js src/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build --config src/client/vite.config.js src/client",
    "test": "node src/server/utils/runAllValidations.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "body-parser": "1.20.9",
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=10.0.0"
  }
}
