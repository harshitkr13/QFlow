# Server Port
PORT=5000

# MongoDB Connection URI (Atlas M0+ Replica Set or local replica set)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qflow?retryWrites=true&w=majority

# Client Application URL (Single origin or comma-separated origins for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret Key (Minimum 32 characters recommended for production)
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters

# Application Environment (development, test, production)
NODE_ENV=development
