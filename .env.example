# ==============================================================================
# QFlow Staging & Production Environment Configuration Reference
# ==============================================================================

# Server Network Port (Configured automatically on cloud hosts like Render)
PORT=5000

# MongoDB Connection URI (Dedicated staging database required for staging)
# Staging:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qflow_staging?retryWrites=true&w=majority
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qflow_prod?retryWrites=true&w=majority
# NOTE: The development database "qflow" is strictly prohibited in staging/production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qflow_staging?retryWrites=true&w=majority

# Client Application URL for CORS Allowlist (Single origin or comma-separated origins)
# Example Staging: https://qflow-staging.vercel.app
# Example Production: https://qflow.vercel.app,https://app.qflow.org
CLIENT_URL=http://localhost:5173

# JWT Secret Signing Key (Minimum 32 random characters required for staging and production)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters

# Application Environment Mode (development, test, staging, production)
NODE_ENV=development

# ==============================================================================
# Client / Frontend Environment Configuration (Vercel / Vite Build Environment)
# ==============================================================================
# Base URL for API requests (set in Vercel project settings)
# If omitted, defaults to "/api" which uses Vercel SPA rewrites configured in vercel.json
VITE_API_URL=https://qflow-backend-staging.onrender.com/api
